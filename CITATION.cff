repository-code: "https://github.com/GDanielGzz/bio-ml-eval-protocols"
keywords:
  - "machine learning"
  - "bioinformatics"
  - "model evaluation"
  - "data leakage"
  - "cluster-aware splits"
  - "bootstrap confidence intervals"
  - "negative results"
  - "reproducibility"
